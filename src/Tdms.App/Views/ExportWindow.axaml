<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tdms.App.ViewModels"
        xmlns:loc="using:Tdms.App.Localization"
        x:Class="Tdms.App.Views.ExportWindow"
        x:DataType="vm:ExportViewModel"
        x:CompileBindings="False"
        Title="Export"
        Icon="/Assets/app.ico"
        Width="620" Height="620"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20,16">

    <TextBlock DockPanel.Dock="Top" Classes="serifHeader" Margin="2,0,0,14"
               Text="{Binding [ExportTitle], Source={x:Static loc:Loc.Instance}}" />

    <!-- Format, delimiter and the derived time column -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="14,12" Margin="0,0,0,12">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="fieldLabel" Text="{Binding [Format], Source={x:Static loc:Loc.Instance}}" />
            <ComboBox x:Name="FormatSelector"
                      ItemsSource="{x:Static vm:ExportViewModel.FormatOptions}"
                      SelectedIndex="{Binding FormatIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{Binding [Delimiter], Source={x:Static loc:Loc.Instance}}" />
            <ComboBox x:Name="DelimiterSelector"
                      ItemsSource="{x:Static vm:ExportViewModel.DelimiterOptions}"
                      SelectedIndex="{Binding DelimiterIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
        <CheckBox IsChecked="{Binding IncludeTimeColumn, Mode=TwoWay}"
                  Content="{Binding [IncludeTime], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
    </Border>

    <!-- Progress and buttons -->
    <Border DockPanel.Dock="Bottom" Padding="2,12,2,0">
      <StackPanel Spacing="10">
        <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                     IsVisible="{Binding IsRunning}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Message}" VerticalAlignment="Center"
                     TextWrapping="Wrap" Classes="muted" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CancelButton" Click="OnCancelClick" IsVisible="{Binding IsRunning}"
                    Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}" />
            <Button x:Name="CloseButton" Click="OnCloseClick" IsEnabled="{Binding !IsRunning}"
                    Content="{Binding [Close], Source={x:Static loc:Loc.Instance}}" />
            <Button x:Name="ExportButton" Click="OnExportClick" Classes="accent"
                    IsEnabled="{Binding !IsRunning}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconDownload}" />
                <TextBlock Text="{Binding [ExportButton], Source={x:Static loc:Loc.Instance}}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Channel picker -->
    <Border Classes="card" Padding="14,12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"
                     Text="{Binding [SelectChannels], Source={x:Static loc:Loc.Instance}}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button x:Name="SelectAllButton" Click="OnSelectAllClick" FontSize="12" Padding="12,5"
                    Content="{Binding [SelectAll], Source={x:Static loc:Loc.Instance}}" />
            <Button x:Name="SelectNoneButton" Click="OnSelectNoneClick" FontSize="12" Padding="12,5"
                    Content="{Binding [SelectNone], Source={x:Static loc:Loc.Instance}}" />
          </StackPanel>
        </Grid>
        <Border Classes="softCard" Padding="10,6">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Content="{Binding DisplayName}" />
                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="mono muted" FontSize="11"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
